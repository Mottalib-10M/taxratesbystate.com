---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/sales-tax-calculator/" title="Sales tax calculator for every US state" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the sales tax calculator: 50 states and DC, free" description="Embed a sales tax calculator with the rate and the grocery and clothing rules of every US state on your own site for free: one iframe line, no sign-up, no tracking, rates kept current." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the sales tax calculator</h1>
    <p class="mt-3 text-lg text-navy-700">Copy one line. Your visitors pick their state, type the local rate, and get the tax forward or backward; when a state changes its rate, the embedded calculator follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: keep the credit link under the calculator visible, do not alter the frame, and use it as provided, without warranty. The frame sets no cookie and sends nothing about your visitors to us.</p>
    <p>Useful for small shops, marketplaces, bookkeepers and local news sites. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/sales-tax-calculator/" title="Sales tax calculator for every US state" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
