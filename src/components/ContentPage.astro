---
/**
 * Renders a topic page of `src/content/pages/`. Order (RECETTE §9.3, §21): H1 and one-line intro; tool
 * page: the folded answer block, then the tool; guide: the answer block, then its mini-simulator, then
 * the body. FAQ (shown and marked up from one list), related pages, sources and publisher box come from PageLayout.
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import SalesTaxCalculator from './calc/SalesTaxCalculator';
import PropertyTaxCalculator from './calc/PropertyTaxCalculator';
import CompareStates from './calc/CompareStates';
import { route, ROUTES } from '../i18n/routes';
import { label, GROUP_LABEL } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById, statePageBySlug } from '../lib/pages';
import { helpers } from '../lib/helpers';
import { SOURCES } from '../lib/engine/params';
import { STATES, CENSUS, stateBySlug } from '../lib/engine/states';
import { compactState } from '../lib/engine/compact';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/page-types';
interface Props { page: PageDef }
const { page } = Astro.props;
const lang = 'en';
const ui = t(lang);
const path = route(page.id, lang);
const parts = page.body(helpers()).split(/<!--mini:([A-Za-z0-9_-]+)(?:\|([a-z-]+))?-->/);
const jsonLd = [articleSchema({ title: page.h1, description: page.description, path, lang }), webPageSchema({ name: page.h1, description: page.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: page.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: page.h1, description: page.description, path, lang }));
if (page.faqs.length) jsonLd.push(faqSchema(page.faqs, lang));
const card = (id: string) => pageById(id)?.card ?? (statePageBySlug(id) ? `Rates, exemptions and property tax in ${stateBySlug(id).name}` : '');
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id), description: card(id) }));
// Sources: a key of params-2026.json, or "state:<slug>" for the main official page of a state.
const sources = page.sources.map((k) => {
  if (k.startsWith('homestead:')) { const s = stateBySlug(k.slice(10)); return { name: `${s.name}: ${s.property.homestead.name ?? 'homestead exemption'} (official page)`, url: s.property.homestead.url ?? '' }; }
  if (k.startsWith('state:')) { const s = stateBySlug(k.slice(6)); return { name: `${s.name}: official sales tax rate page`, url: s.sales.local.url ?? s.sales.facts?.[0]?.url ?? '' }; }
  return { name: SOURCES[k].label, url: SOURCES[k].url };
}).filter((s) => s.url);
const methodHref = route('method', lang);
const compact = STATES.map(compactState);
const tp = page.toolProps ?? {};
/** Argument of a state-specific mini written in the body as <!--mini:kind|slug-->. */
const miniArg = (slug?: string) => {
  if (!slug) return undefined;
  const s = stateBySlug(slug);
  return JSON.stringify({ name: s.name, ratio: s.census.effectiveRate, medianTax: s.census.medianTax, medianValue: s.census.medianValue, rate: s.sales.stateRate });
};
---
<PageLayout title={page.title} description={page.description} lang={lang} jsonLd={jsonLd} faqs={page.faqs} related={related} sources={sources} breadcrumbs={[{ label: page.nav }]}>
  <article>
    <header class="mb-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">{GROUP_LABEL[page.group]}</p>
      <h1 class="mt-1 font-serif text-3xl font-bold text-navy-900 md:text-4xl">{page.h1}</h1>
      <p class="mt-3 text-lg text-navy-700">{page.intro}</p>
      <p class="mt-3 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method')}</a></p>
    </header>
    {page.tool ? (
      <>
        <Clamp text={page.resume} lang={lang} id={`clamp-${page.id}`} class="mb-4" />
        <div data-outil class="mb-10">
          {(page.tool === 'sales' || page.tool === 'reverse') && <SalesTaxCalculator client:load states={compact} state={tp.state} lockState={tp.lockState} category={tp.category} price={tp.price} mode={page.tool === 'reverse' ? 'remove' : tp.mode} methodHref={methodHref} idPrefix={page.id.slice(0, 10)} />}
          {page.tool === 'property' && <PropertyTaxCalculator client:load states={compact} state={tp.state} value={tp.price} advanced={tp.advanced} censusYear={CENSUS.year} methodHref={methodHref} idPrefix={page.id.slice(0, 10)} />}
          {page.tool === 'compare' && <CompareStates client:load states={compact} censusYear={CENSUS.year} idPrefix={page.id.slice(0, 10)} />}
        </div>
      </>
    ) : (
      <>
        <p class="mb-6 text-navy-800">{page.resume}</p>
        {page.mini && <MiniSim client:load kind={page.mini} arg={page.miniArg} href={route('home', lang)} />}
      </>
    )}
    <div class="prose prose-slate max-w-none prose-headings:font-serif">
      {parts.map((p, i) => i % 3 === 0 ? <Fragment set:html={p ?? ''} /> : i % 3 === 1 ? <MiniSim client:load kind={p} arg={miniArg(parts[i + 1])} href={route('home', lang)} /> : null)}
    </div>
  </article>
</PageLayout>
